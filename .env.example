# ==============================================================================
# Global AI Agent Configurator - Environment Configuration Template
# Copy this file to .env or use these variables when configuring %USERPROFILE%\.agents\mcp.json
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# GitHub MCP Server
# Required for repository management, creating issues, PRs, and reading code.
# Generate at: https://github.com/settings/tokens (classic with 'repo' scope or fine-grained)
GITHUB_PERSONAL_ACCESS_TOKEN="ghp_mocktoken0000000000000000000000000000"

# Brave Search MCP Server
# Used for real-time web search by AI agents.
# Obtain from: https://api.search.brave.com/app/dashboard
BRAVE_API_KEY="BSA_mockkey000000000000000000000000"

# Supabase MCP Server
# Personal Access Token (PAT) for database querying and table management.
# Obtain from: https://supabase.com/dashboard/account/tokens
SUPABASE_PAT_TOKEN="sbp_mocktoken0000000000000000000000000000000000000000"

# Google Search Console MCP Server
# Google Cloud Service Account credentials for live SEO search analytics.
GSC_CLIENT_EMAIL="ai-agent-gsc@your-project-id.iam.gserviceaccount.com"
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Central Agents Directory Override (Optional)
# Default: C:\Users\<Username>\.agents
# GLOBAL_AGENTS_ROOT="C:\\Users\\YourUser\\.agents"
